{
 "uid": "demo-debug",
 "title": "Debug log（用 correlation_id 串起所有服務）",
 "tags": [
  "demo"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "refresh": "10s",
 "templating": {
  "list": [
   {
    "name": "correlation_id",
    "label": "correlation_id / 訂單編號 / 任何關鍵字",
    "type": "textbox",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    }
   },
   {
    "name": "service",
    "label": "服務",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "label": "service",
     "stream": "",
     "type": 1
    },
    "definition": "label_values(service)",
    "includeAll": true,
    "multi": true,
    "allValue": ".+",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   },
   {
    "name": "level",
    "label": "等級",
    "type": "custom",
    "query": "debug,info,warn,error",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "log 數量（依等級）",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (level) (count_over_time({service=~\"$service\", level=~\"$level\"} |= \"$correlation_id\" [$__auto]))",
     "legendFormat": "{{level}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "警告／錯誤（依服務）",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (service) (count_over_time({level=~\"warn|error\"} |= \"$correlation_id\" [$__auto]))",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "logs",
   "title": "log（輸入 correlation_id 或訂單編號，所有服務依時間排序）",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 24,
    "h": 18
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{service=~\"$service\", level=~\"$level\"} |= \"$correlation_id\""
    }
   ],
   "options": {
    "showTime": true,
    "showLabels": true,
    "wrapLogMessage": true,
    "prettifyLogMessage": false,
    "enableLogDetails": true,
    "sortOrder": "Ascending",
    "dedupStrategy": "none"
   }
  },
  {
   "id": 4,
   "type": "table",
   "title": "訂單狀態（MySQL）",
   "datasource": {
    "type": "mysql",
    "uid": "mysql"
   },
   "gridPos": {
    "x": 0,
    "y": 25,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "mysql"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT status AS 狀態, COUNT(*) AS 筆數 FROM orders GROUP BY status ORDER BY 2 DESC"
    }
   ]
  },
  {
   "id": 5,
   "type": "table",
   "title": "付款 × 預約（MySQL）",
   "datasource": {
    "type": "mysql",
    "uid": "mysql"
   },
   "gridPos": {
    "x": 8,
    "y": 25,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "mysql"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT p.capture_mode AS 模式, p.status AS 付款, COALESCE(b.status,'-') AS 預約, COUNT(*) AS 筆數 FROM payments p JOIN orders o ON o.id=p.order_id LEFT JOIN bookings b ON b.order_no=o.order_no GROUP BY 1,2,3 ORDER BY 4 DESC"
    }
   ]
  },
  {
   "id": 6,
   "type": "table",
   "title": "最近 20 筆訂單（點 correlation_id 複製到上面查）",
   "datasource": {
    "type": "mysql",
    "uid": "mysql"
   },
   "gridPos": {
    "x": 16,
    "y": 25,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "mysql"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT order_no, status, correlation_id FROM orders ORDER BY id DESC LIMIT 20"
    }
   ]
  }
 ]
}