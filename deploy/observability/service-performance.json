    {
      "id": 2,
      "title": "每個 Pod 的平均 CPU（核；有擴充時看單一 Pod 有沒有吃滿）",
      "description": "先把同一個 Pod 裡的容器加起來，再對同一個服務的所有 Pod 取平均。虛線是 1 核：單執行緒的服務（hub、core-worker、core-relay、localstack、redis、partners）一個 Pod 最多 1 核，碰到虛線就是滿了；core-api（PHP-FPM）、MySQL 是多程序，可以超過 1 核。",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (app_service) (sum by (app_service, pod) (rate(container_cpu_usage_seconds_total{env=\"$env\"}[1m])))",
          "legendFormat": "{{app_service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: 核",
          "decimals": 2,
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "axisSoftMax": 1
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
