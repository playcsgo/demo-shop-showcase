{
  "uid": "service-performance",
  "title": "服務效能：每一站與 CPU",
  "tags": [
    "demo-shop"
  ],
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "環境",
        "type": "custom",
        "query": "k8s,dev-container : sandbox-01",
        "current": {
          "text": "k8s",
          "value": "k8s"
        },
        "options": [
          {
            "text": "k8s",
            "value": "k8s",
            "selected": true
          },
          {
            "text": "dev-container",
            "value": "sandbox-01",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "title": "k6 計畫",
      "description": "這段時間 k6 預計要送的結帳數＝實際送出＋沒送出。只算 loadtest/run.mjs 跑的壓測（UI 的壓測也是）",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(max_over_time(k6_http_reqs_total{env=\"$env\", step=\"checkout\"}[$__range])) or vector(0)) + (sum(max_over_time(k6_dropped_iterations_total{env=\"$env\", scenario=~\".*order.*\"}[$__range])) or vector(0))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 11,
      "title": "系統完成",
      "description": "已交給物流的訂單數（分成多個包裹也只算一筆）",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(sum_over_time(((demo_order_lifecycle_ms_count{env=\"$env\"} - (demo_order_lifecycle_ms_count{env=\"$env\"} offset 15s)) > 0 or ((demo_order_lifecycle_ms_count{env=\"$env\"} < (demo_order_lifecycle_ms_count{env=\"$env\"} offset 15s)) * 1) or ((demo_order_lifecycle_ms_count{env=\"$env\"} unless last_over_time(demo_order_lifecycle_ms_count{env=\"$env\"}[10m] offset 15s)) * 1))[$__range:15s])) or vector(0))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 12,
      "title": "未完成",
      "description": "已被受理（2xx）但還沒交給物流。壓測中不是 0 是正常的；跑完沒歸零就是卡住",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min((sum(max_over_time(k6_http_reqs_total{env=\"$env\", step=\"checkout\", status=~\"2..\"}[$__range])) or vector(0)) - ((sum(sum_over_time(((demo_order_lifecycle_ms_count{env=\"$env\"} - (demo_order_lifecycle_ms_count{env=\"$env\"} offset 15s)) > 0 or ((demo_order_lifecycle_ms_count{env=\"$env\"} < (demo_order_lifecycle_ms_count{env=\"$env\"} offset 15s)) * 1) or ((demo_order_lifecycle_ms_count{env=\"$env\"} unless last_over_time(demo_order_lifecycle_ms_count{env=\"$env\"}[10m] offset 15s)) * 1))[$__range:15s])) or vector(0))), 0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
