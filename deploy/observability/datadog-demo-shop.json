                  "tooltip": [
                    {
                      "field": "站"
                    },
                    {
                      "field": "百分位數"
                    },
                    {
                      "field": "毫秒",
                      "format": ".1f"
                    }
                  ]
                }
              }
            ]
          }
        },
        "type": "wildcard"
      },
