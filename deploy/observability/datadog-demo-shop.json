{
  "title": "Demo Shop — 微服務處理時間（每一站花多久）",
  "description": "壓測時看：一筆直送訂單經過的每個服務「收到 → 做完」花多久，以及整筆訂單從結帳到交給物流花多久（p50／p90／p99）。匯入：Dashboards → New Dashboard → 右上角齒輪 → Import dashboard JSON。",
  "widgets": [
    {
      "id": 3552495460903699,
      "definition": {
        "title": "每個服務「收到 → 做完」花多久（毫秒，p50／p90／p99）",
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "data_source": "metrics",
                "name": "q50",
                "query": "p50:demo.pipeline.handle_ms{$env AND step IN (core-api.post.checkout,core-relay.payment.requested,hub.payment.requested,hub.webhook.mockpay.charge.succeeded,core-worker.payment.succeeded,core-relay.shipment.requested,hub.shipment.requested)} by {step}",
                "aggregator": "percentile"
              },
              {
                "data_source": "metrics",
                "name": "q90",
                "query": "p90:demo.pipeline.handle_ms{$env AND step IN (core-api.post.checkout,core-relay.payment.requested,hub.payment.requested,hub.webhook.mockpay.charge.succeeded,core-worker.payment.succeeded,core-relay.shipment.requested,hub.shipment.requested)} by {step}",
                "aggregator": "percentile"
              },
              {
                "data_source": "metrics",
                "name": "q99",
                "query": "p99:demo.pipeline.handle_ms{$env AND step IN (core-api.post.checkout,core-relay.payment.requested,hub.payment.requested,hub.webhook.mockpay.charge.succeeded,core-worker.payment.succeeded,core-relay.shipment.requested,hub.shipment.requested)} by {step}",
                "aggregator": "percentile"
              }
            ],
            "formulas": [
              {
                "formula": "q50",
                "alias": "p50"
              },
              {
                "formula": "q90",
                "alias": "p90"
              },
              {
                "formula": "q99",
                "alias": "p99"
              }
            ]
          }
        ],
        "specification": {
          "type": "vega-lite",
          "contents": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "description": "橫軸是一筆直送訂單依序經過的七站；縱軸是那一站自己的處理時間（不是累計）",
            "data": {
              "name": "table1"
            },
            "transform": [
              {
                "fold": [
                  "p50",
                  "p90",
                  "p99"
                ],
                "as": [
                  "百分位數",
                  "毫秒"
                ]
              },
              {
                "calculate": "indexof([\"core-api.post.checkout\",\"core-relay.payment.requested\",\"hub.payment.requested\",\"hub.webhook.mockpay.charge.succeeded\",\"core-worker.payment.succeeded\",\"core-relay.shipment.requested\",\"hub.shipment.requested\"], datum.step)",
                "as": "順序"
              },
              {
                "calculate": "{'core-api.post.checkout':'① core-api 結帳 API','core-relay.payment.requested':'② core-relay 送出付款指令','hub.payment.requested':'③ hub 呼叫金流','hub.webhook.mockpay.charge.succeeded':'④ hub 收付款通知','core-worker.payment.succeeded':'⑤ core-worker 付款成功→寫出貨','core-relay.shipment.requested':'⑥ core-relay 送出出貨指令','hub.shipment.requested':'⑦ hub 交給物流'}[datum.step]",
                "as": "站"
              }
            ],
            "width": "container",
            "height": "container",
            "layer": [
              {
                "mark": {
                  "type": "line",
                  "point": {
                    "size": 60
                  },
                  "strokeWidth": 2
