                  "y": {
                    "field": "毫秒",
                    "type": "quantitative",
                    "axis": {
                      "title": "這一站的處理時間（毫秒）"
                    }
                  },
                  "color": {
                    "field": "百分位數",
                    "type": "nominal",
                    "sort": [
                      "p50",
                      "p90",
                      "p99"
                    ],
                    "scale": {
                      "range": [
                        "#2a78d6",
                        "#eb6834",
                        "#1baf7a"
                      ]
                    },
                    "legend": {
                      "orient": "top",
                      "title": null
                    }
