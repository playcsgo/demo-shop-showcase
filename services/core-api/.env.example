APP_NAME=core-api
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:18080

APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=demo
DB_USERNAME=demo
DB_PASSWORD=demo
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# 商品圖片的 bucket（LocalStack 要用 path style）
AWS_BUCKET=demo-product-images
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Asia/Taipei
# SQS（本機 LocalStack；上雲時移除 AWS_ENDPOINT、改用 IAM role）
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-northeast-1
AWS_ENDPOINT=http://localstack:4566
SQS_PREFIX=http://localstack:4566/000000000000

# demo：PENDING_PAYMENT 超過 20 秒就主動查詢（正式環境約 15 分鐘）
PAYMENT_RECONCILE_AFTER_SECONDS=20
# demo：付款期限 180 秒（必須大於 SQS 重試窗口 150 秒；正式環境約 15 分鐘）
PAYMENT_EXPIRE_AFTER_SECONDS=180
# BFF → core 換發顧客 token 的服務金鑰（本機用；正式環境放 Secrets Manager）
BFF_SERVICE_KEY=local-bff-service-key
SUPPORT_SERVICE_KEY=local-support-service-key

# hub 內部 API（醫院保留時段）
HUB_URL=http://hub:3000
INTERNAL_API_KEY=local-internal-key
