# sandbox／CI 用：正式模式的 core image（開發用的是 docker/Dockerfile，程式碼用掛載的）
#   - 程式碼 build 進 image，不掛主機的資料夾 → 每套各自獨立，不會互相污染
#   - 只裝正式套件（--no-dev）、opcache 不檢查檔案變動
#   - 啟動時依「這一套」的環境變數做 config／route／view／event cache（docker/sandbox-entrypoint.sh）
# 基底沿用開發用的 demo-core-php:8.3（PHP 擴充、ddtrace 都一樣），scripts/sandbox.sh 會先 build 它
ARG BASE_IMAGE=demo-core-php:8.3

FROM ${BASE_IMAGE} AS php
# 先只複製套件清單：程式碼改了，這兩層（最慢的 composer install）可以沿用快取
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction --no-progress
COPY . .
RUN composer dump-autoload --optimize --no-dev \
 && php artisan package:discover --ansi \
 && php artisan filament:assets \
 && echo "opcache.validate_timestamps=0" > /usr/local/etc/php/conf.d/zz-sandbox.ini \
 && chown -R www-data:www-data storage bootstrap/cache
ENTRYPOINT ["/var/www/html/docker/sandbox-entrypoint.sh"]
CMD ["php-fpm"]

# nginx 也要有 public/（靜態檔、index.php 的路徑），從上一階段複製，不掛主機資料夾
FROM nginx:1.27-alpine AS nginx
COPY --from=php /var/www/html/public /var/www/html/public
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
