APP_NAME=經銷商後台
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:28080
APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=distributor-mysql
DB_PORT=3306
DB_DATABASE=distributor
DB_USERNAME=distributor
DB_PASSWORD=distributor

# 不靠 Redis：session 和快取都放自己的資料庫，這個服務只需要 MySQL
SESSION_DRIVER=database
SESSION_COOKIE=distributor_session
CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
