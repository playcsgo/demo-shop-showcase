# ───────── 觀測開關（scripts/up.sh 讀這裡；寫 TRUE 才開，沒寫、空白、FALSE 都是關）─────────

# 本機 debug log：Alloy 收集 → Loki 儲存 → Grafana 查詢（http://localhost:13300）
#   開：開發、除錯、跑情境測試　　關：只想跑 demo、不想佔資源
#   關閉時程式照常輸出到 stdout，只是不收集
#   清空已收集的 log：scripts/logs-reset.sh；平常超過 LOKI_RETENTION 自動刪除
DEBUG_LOG=TRUE

# Datadog：Agent＋APM trace＋log（需要下面的 DD_API_KEY）
#   開：錄影、展示 Service Map　　關：平常開發（省試用額度）
DATA_DOG=FALSE

# core-api 的 PHP 執行方式（K8s）：fpm（預設）／octane（Laravel Octane＋Swoole）。改完跑 scripts/bootstrap.sh，或直接 scripts/k8s.sh runtime octane
CORE_RUNTIME=fpm

# 前台＋BFF 用哪一版：nest（預設：NestJS BFF＋Vite 前台）／next（Next.js 一個服務，services/web-next）
#   dev-container：改完跑 scripts/up.sh --build　　K8s：scripts/k8s.sh web next
WEB_RUNTIME=nest

# 程式寫多少 log（所有服務共用；和上面「收不收集」無關）
#   debug：全部，含每次呼叫廠商、每次狀態轉移（包括沒套用的）、去重結果 → 除錯、跑情境測試
#   info ：重要事件：訂單建立、付款結果、補償動作、亂序事件
#   warn ：只有警告和錯誤 → 平常、正式環境
#   error：只有錯誤
#   不管哪一級，錯誤一定會輸出
LOG_LEVEL=debug

# 本機 log 保存多久（Loki 自動刪除），例如 24h、72h、168h
#   至少 24h，而且要是 24h 的倍數：Loki 的索引一天一個檔案，以天為單位刪除
#   到期後不會馬上消失：compactor 每 10 分鐘掃一次，標記後再等約 2 小時才真正刪
LOKI_RETENTION=72h

# 常見組合：
#   開發、除錯、跑大規模情境：DEBUG_LOG=TRUE  DATA_DOG=FALSE LOG_LEVEL=debug
#   錄影片、展示 Datadog    ：DEBUG_LOG=FALSE DATA_DOG=TRUE  LOG_LEVEL=info
#   只把 demo 跑起來         ：DEBUG_LOG=FALSE DATA_DOG=FALSE LOG_LEVEL=warn
#   CI                       ：DEBUG_LOG=TRUE  DATA_DOG=FALSE LOG_LEVEL=debug（失敗時打包 log 上傳）

# ───────── Datadog（DATA_DOG=TRUE 才會用到）─────────
DD_API_KEY=
DD_SITE=ap1.datadoghq.com
